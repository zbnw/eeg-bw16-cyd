import serial
import matplotlib.pyplot as plt
import matplotlib.animation as animation
from collections import deque
import struct
import time
import threading
import numpy as np


# 1

def parse_small_packet(packet):
    """
    解析小包：AA AA 04 80 02 xxHigh xxLow xxCheckSum
    返回：rawdata (原始值)
    """
    # 固定检查
    if packet[0] != 0xAA or packet[1] != 0xAA or packet[2] != 0x04 or packet[3] != 0x80 or packet[4] != 0x02:
        return None

    # 高字节和低字节
    high_byte = packet[5]  # xxHigh
    low_byte = packet[6]  # xxLow

    # 组合成16位整数 (高字节在高8位，低字节在低8位)
    rawdata = (high_byte << 8) | low_byte

    # 转换为有符号数 (超过32767是负数)
    if rawdata > 32767:
        rawdata = rawdata - 65536

    # 校验和验证
    checksum = packet[7]
    # 计算校验和
    calc_checksum = (0xAA + 0xAA + 0x04 + 0x80 + 0x02 + high_byte + low_byte) & 0xFF
    if calc_checksum != checksum:


